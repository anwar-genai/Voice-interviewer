# Every value here maps to a field on app.core.config.Settings.
# Names are case-insensitive; the canonical form is UPPER_SNAKE_CASE.

# --- LiveKit ---
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cerebras (LLM) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# --- Deepgram (STT/TTS) ---
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en

# --- Agent behavior ---
AGENT_TEMPERATURE=0.7

# --- Turn detection / endpointing (voice responsiveness) ---
# "english" | "multilingual" | "vad" | "stt". Run once: python run_agent.py download-files
TURN_DETECTION_MODEL=english
MIN_ENDPOINTING_DELAY_SECONDS=0.5
MAX_ENDPOINTING_DELAY_SECONDS=4.0
# Noisy room (fan/street) making the agent stop mid-sentence? Raise both:
# VAD_ACTIVATION_THRESHOLD=0.65  MIN_INTERRUPTION_DURATION_SECONDS=1.0
VAD_ACTIVATION_THRESHOLD=0.5
MIN_INTERRUPTION_DURATION_SECONDS=0.5

# --- Auth (Supabase) ---
# New projects (asymmetric signing keys): set SUPABASE_URL; tokens verify via JWKS.
SUPABASE_URL=https://<your-project>.supabase.co
# Older projects (legacy HS256): set the shared secret instead (Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=
# Fail closed. Set to false ONLY for local dev/tests with no Supabase project.
AUTH_ENABLED=true

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect / Settings -> Database -> Connection string.
# Use the direct or session-mode pooler URI, and the psycopg driver:
#   postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=
# Interviews older than this are purged by app/db/retention.py.
RETENTION_DAYS=30

# --- API ---
# Comma-separated allowlist, no "*". Add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Request limits ---
MAX_PDF_BYTES=10485760
MAX_JOB_TEXT_CHARS=50000
MAX_RESUME_CHARS=50000
RATE_LIMIT_PER_MINUTE=20

# --- Cost telemetry (list prices; used only to estimate per-interview cost) ---
# CEREBRAS_INPUT_USD_PER_MTOK=0.25
# CEREBRAS_OUTPUT_USD_PER_MTOK=0.69
# DEEPGRAM_STT_USD_PER_MINUTE=0.0077
# DEEPGRAM_TTS_USD_PER_1K_CHARS=0.030

# --- Evals ---
# LLM-judge model: a different family from CEREBRAS_MODEL, must exist on your
# Cerebras account (GET /v1/models lists them).
# EVAL_JUDGE_MODEL=zai-glm-4.7

# --- Error tracking ---
# Set a Sentry DSN to report API + agent-worker errors. Off when empty.
# SENTRY_DSN=

# --- Metrics export ---
# Agent worker serves Prometheus metrics on :{port}/metrics when set
# (fly.toml sets 9464 in production; Fly scrapes it into fly-metrics.net).
# PROMETHEUS_PORT=9464
