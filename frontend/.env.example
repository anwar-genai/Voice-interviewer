# Backend API base URL.
VITE_API_BASE=http://localhost:8000

# Supabase project (dashboard -> Settings -> API). The publishable/anon key is browser-safe.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
# New projects: publishable key (sb_publishable_...). Older projects: use VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" while the voice agent worker runs on-demand (e.g. locally for
# scheduled demos, rather than an always-on deployed worker). Shows a "live
# interviews run during demo sessions" note on the welcome card. Unset once an
# always-on worker is deployed.
# VITE_DEMO_MODE=true
